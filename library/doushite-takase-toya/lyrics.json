    {
      "id": "s021",
      "lyrics": "君以上の人にはなれないからさ",
      "translation": "也没办法成为胜过你的人啊",
      "layers": [
        {
          "id": "romaji",
          "label": "Romaji",
          "text": "kimi ijou no hito ni wa narenai kara sa"
        }
      ],
      "ruby": [
        {
          "start": 0,
          "end": 1,
