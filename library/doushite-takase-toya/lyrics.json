    {
      "id": "s025",
      "lyrics": "君と過ごせて今日も良かった",
      "translation": "今天也能和你一起度过，真好",
      "layers": [
        {
          "id": "romaji",
          "label": "Romaji",
          "text": "kimi to sugosete kyou mo yokatta"
        }
      ],
      "ruby": [
        {
          "start": 0,
          "end": 1,
          "base": "君",
          "reading": "きみ"
        },
        {
          "start": 2,
          "end": 6,
          "base": "過ごせて",
          "reading": "すごせて"
        },
        {
          "start": 6,
          "end": 8,
          "base": "今日",
          "reading": "きょう"
        },
        {
          "start": 9,
          "end": 13,
          "base": "良かった",
          "reading": "よかった"
        }
      ],
      "notes": [
        {
          "title": "過ごせる → 過ごせた → 過ごせて",
          "body": "同一核心动词在三轮结尾依次变化：能一起度过（可能/愿望）、曾能一起度过（过去可能）、能够一起度过而……（て形连接评价）。这种微调把“今天”从愿望推向回忆，再推到最后的梦境反转。"
        }
      ]
    },
    {
      "id": "s026",
      "lyrics": "夢が覚めたら 今日が終わっていた",
