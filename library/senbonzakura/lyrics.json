{
  "segments": [
    {
      "id": "s001",
      "lyrics": "大胆不敵に ハイカラ革命",
      "ruby": [
        {
          "start": 0,
          "end": 4,
          "base": "大胆不敵",
          "reading": "だいたんふてき"
        },
        {
          "start": 6,
          "end": 10,
          "base": "ハイカラ",
          "reading": "はいから"
        },
        {
          "start": 10,
          "end": 12,
          "base": "革命",
          "reading": "かくめい"
        }
      ],
      "translation": "大胆无畏维新革命",
      "layers": [
        {
          "id": "romaji",
          "label": "Romaji",
          "text": "daitan futeki ni haikara kakumei"
        }
      ],
      "notes": [
        {
          "title": "ハイカラ",
          "body": "源自英语 high collar。明治后期起，“ハイカラ”从高领洋装延伸为西洋式、时髦、追逐新风尚之意；「ハイカラ革命」因此同时带有近代化与新潮感。"
        }
      ]
    },
    {
      "id": "s002",
      "lyrics": "磊々落々 反戦国家",
      "ruby": [
        {
          "start": 0,
          "end": 4,
          "base": "磊々落々",
          "reading": "らいらいらくらく"
        },
        {
          "start": 5,
          "end": 9,
          "base": "反戦国家",
          "reading": "はんせんこっか"
        }
      ],
      "translation": "光明磊落反战国家",
      "layers": [
        {
          "id": "romaji",
          "label": "Romaji",
          "text": "rairai rakuraku hansen kokka"
        }
      ],
      "notes": [
        {
          "title": "磊々落々",
          "body": "读作「らいらいらくらく」。是把「磊落」加倍强化的四字语，表示胸襟开阔、坦荡、不拘小节；这里与紧接的「反戦国家」形成故意夸张的政治口号感。"
        }
      ]
    },
